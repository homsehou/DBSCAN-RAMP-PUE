# Python and Jupyter working files
__pycache__/
*.pyc
.ipynb_checkpoints/
.virtual_documents/
*.egg-info/
.venv/

# Per-client execution logs (large, regenerated at every run). The verification
# logs at the root of resultats/ stay under version control on purpose.
resultats/logs/
resultats/*/logs/

# Local replay of the whole chain (python src/run.py --prefix rejeu/)
resultats/rejeu/

.DS_Store
launch_jupyter.sh

# No PDF or LaTeX output under version control: figures are kept as PNG only
*.pdf
*.tex

# Intermediate candidates of the search, regenerated by steps 4 to 7
resultats/*/finalistes/
resultats/*/reference_saison/finalistes/

# Intermediate runs of the hold-out check (only the retained parameters and the verdicts are kept)
resultats/holdout*/calib_directe*/
resultats/holdout*/calib_union_*/
resultats/holdout*/arbitrage_fft/
resultats/holdout*/essai_fft_grille/
# Days of the two parts: same files as resultats/cibles_v9/journees/
resultats/cibles_calage/journees/
resultats/cibles_test/journees/
resultats/cibles_annee_*/journees/
